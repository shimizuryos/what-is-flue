{
  "name": "flue-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Flue（AIエージェントフレームワーク）をコードを動かしながら学べるWebアプリ",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node server/index.ts --dev",
    "build": "vite build",
    "start": "vite build && node server/index.ts",
    "serve": "node server/index.ts",
    "check": "tsc -p tsconfig.json && tsc -p lessons/tsconfig.json",
    "test": "node scripts/test-lessons.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@flue/cli": "2.3.0",
    "@flue/runtime": "2.3.0",
    "@flue/vite": "2.3.0",
    "hono": "^4.13.13",
    "just-bash": "^3.6.0",
    "valibot": "^1.5.0",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.2",
    "marked": "^18.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
